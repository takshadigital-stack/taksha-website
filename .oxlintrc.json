{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true,
        "allowExportNames": [
          "useAuth",
          "useWorkspace",
          "useTheme",
          "usePrefersReducedMotion",
          "organizationSchema",
          "breadcrumbSchema",
          "faqSchema",
          "localBusinessSchema",
          "serviceSchema",
          "creativeWorkSchema"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/router.jsx"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
