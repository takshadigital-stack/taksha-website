generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          String   // 'INTERN' or 'MENTOR'
  track         String?  // e.g., 'Frontend'
  progress      Int?     @default(0)
  status        String?  @default("On Track")
  phone         String?
  location      String?
  isAlumni      Boolean  @default(false)
  alumniSince   DateTime?
  
  // Taksha HR fields
  mustChangePassword Boolean @default(false)
  dob           String?  // format DD/MM/YYYY or similar for password gen
  
  // Profile fields imported from application
  college         String?
  degree          String?
  specialization  String?
  currentYear     String?
  graduationYear  String?
  skills          String?
  experience      String?
  githubUrl       String?
  linkedinUrl     String?
  resumeUrl       String?
  portfolioUrl    String?
  duration        String?
  availability    String?
  
  preferences Json?
  leaveRequests LeaveRequest[]

  // Relations
  mentorId      String?
  mentor        User?    @relation("MentorInterns", fields: [mentorId], references: [id])
  interns       User[]   @relation("MentorInterns")
  
  assignedTasks Task[]   @relation("TaskAssignee")
  createdTasks  Task[]   @relation("TaskAssigner")
  announcements Announcement[]
  submissions   Submission[] @relation("InternSubmissions")
  reviews       Submission[] @relation("MentorReviews")
  certificates  Certificate[] @relation("InternCertificates")
  assignments   ProjectAssignment[] @relation("InternAssignments")
  
  sentMessages  Message[]    @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  deadlineDays Int     @default(7)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  tasks       Task[]
  submissions Submission[]
  assignments ProjectAssignment[]
}

model ProjectAssignment {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  internId     String
  intern       User     @relation("InternAssignments", fields: [internId], references: [id], onDelete: Cascade)
  
  assignedAt   DateTime @default(now())
  deadlineDays Int      @default(7)
  deadlineAt   DateTime
  status       String   @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED, AUTO_SUBMITTED
  
  @@unique([projectId, internId])
}

model Task {
  id             String   @id @default(uuid())
  title          String
  priority       String   @default("Medium")
  status         String   @default("TODO") // TODO, DONE
  date           String   // Storing as string to match current frontend format
  skillTags      String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  assigneeId     String
  assignee       User     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  
  assignerId     String
  assigner       User     @relation("TaskAssigner", fields: [assignerId], references: [id])
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  date      String
  
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
}

model Application {
  id              String   @id @default(uuid())
  name            String
  email           String
  portfolio       String?  // Legacy or portfolio url
  message         String?  // Legacy or cover letter
  roleId          String
  roleTitle       String
  status          String   @default("Pending")
  date            String
  createdAt       DateTime @default(now())

  // New Fields - Section 1: Personal
  phone           String?
  location        String?

  // Section 2: Education
  college         String?
  degree          String?
  specialization  String?
  currentYear     String?
  graduationYear  String?

  // Section 3 & 4: Skills & Projects
  skills          String?
  experience      String?
  hasProjects     Boolean? @default(false)
  bestProject     String?
  githubUrl       String?
  linkedinUrl     String?

  // Section 5: Resume
  resumeUrl       String?

  // Section 6: Availability
  duration        String?
  availability    String?
  hoursPerWeek    String?
  startDate       String?

  // Section 7: Motivation
  motivation      String?
  expectations    String?
  whySelectYou    String?

  // Section 8: Source
  source          String?

  // Taksha HR AI Evaluation Fields
  aiScore             Int?
  aiStrengths         String? // stored as JSON string or text
  aiWeaknesses        String? // stored as JSON string or text
  aiMissingSkills     String? // stored as JSON string or text
  aiRecommendation    String? // Strong Match, Potential Match, Weak Match
  
  // Offer Pipeline Fields
  offerStatus         String? // Generated, Awaiting Approval, Sent, Accepted, Declined
  offerUrl            String? // Link to generated PDF
  offerGeneratedAt    DateTime?
  offerRespondedAt    DateTime?
}

model SystemLog {
  id          String   @id @default(uuid())
  action      String
  candidate   String?  // Candidate Name or User Name
  result      String?
  timestamp   DateTime @default(now())
  performedBy String   // "Taksha HR", "Super Admin", etc.
}

model SystemSettings {
  id                  String   @id @default("taksha-hr-settings")
  enableAiAnalysis    Boolean  @default(true)
  offerGenerationMode String   @default("Generate + Admin Approval")
  accountCreationMode String   @default("After Offer Accepted")
  updatedAt           DateTime @updatedAt
}

model Submission {
  id             String   @id @default(uuid())
  githubUrl      String
  liveUrl        String?
  description    String?
  fileUrl        String?
  fileName       String?
  videoUrl       String?
  firstPassReview Json?
  status         String   @default("Submitted") // Submitted, Under Review, Approved, Changes Requested
  mentorFeedback String?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  internId       String
  intern         User     @relation("InternSubmissions", fields: [internId], references: [id])
  
  reviewedById   String?
  reviewedBy     User?    @relation("MentorReviews", fields: [reviewedById], references: [id])
}

model Certificate {
  id                String   @id @default(uuid())
  certificateNumber String   @unique
  role              String
  startDate         String
  endDate           String
  projectsCompleted Json?
  fileUrl           String?
  issuedAt          DateTime @default(now())
  
  internId          String
  intern            User     @relation("InternCertificates", fields: [internId], references: [id])
}

model Message {
  id         String   @id @default(uuid())
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

model LeaveRequest {
  id String @id @default(uuid())
  internId String
  intern User @relation(fields: [internId], references: [id], onDelete: Cascade)
  type String
  from String
  to String
  reason String
  days Int
  status String @default("PENDING")
  createdAt DateTime @default(now())
  @@index([internId, createdAt])
}
